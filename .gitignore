# The Token product repo lives at ./token/ and is its own git repository.
# Without this line, `git add -A` here writes a gitlink (mode 160000) with no
# .gitmodules to back it — the course repo would track a commit SHA it cannot
# fetch, and a fresh clone would get an empty token/ directory.
/token/

# OS noise
Thumbs.db
desktop.ini
.DS_Store
